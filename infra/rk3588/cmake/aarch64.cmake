set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ENV{VINS_ARM_SYSROOT} OR NOT DEFINED ENV{VINS_CROSS_ROOT})
  message(FATAL_ERROR "Set VINS_ARM_SYSROOT and VINS_CROSS_ROOT to the verified target SDK/compiler roots")
endif()
set(CMAKE_SYSROOT "$ENV{VINS_ARM_SYSROOT}")
set(CMAKE_C_COMPILER "$ENV{VINS_CROSS_ROOT}/usr/bin/aarch64-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "$ENV{VINS_CROSS_ROOT}/usr/bin/aarch64-linux-gnu-g++")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" "$ENV{VINS_ARM_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# Target programs cannot execute on the x86 host during configure.
set(THREADS_PTHREAD_ARG "0" CACHE STRING "Cross target pthread availability" FORCE)
